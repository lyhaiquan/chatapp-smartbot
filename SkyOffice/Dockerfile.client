# SkyOffice Client — Multi-stage Docker build
# Stage 1: Build the Vite app
FROM node:18-alpine AS builder
WORKDIR /app

# ── Accept build args and expose them as ENV for Vite ──────────────────
ARG VITE_SERVER_URL=ws://localhost:2567
ENV VITE_SERVER_URL=${VITE_SERVER_URL}

# ── 1. Install types/ deps (@colyseus/schema for TS resolution) ───────
COPY types/package.json types/yarn.lock ./types/
RUN cd types && yarn install --frozen-lockfile

# ── 2. Install client deps ─────────────────────────────────────────────
COPY client/package.json client/yarn.lock ./client/
RUN cd client && yarn install --frozen-lockfile

# ── 3. Copy all source ─────────────────────────────────────────────────
COPY types ./types/
COPY client ./client/

# ── 4. Build — use vite build directly (skip tsc strict type check) ───
# Vite uses esbuild for transpilation and doesn't require strict tsc pass
WORKDIR /app/client
RUN yarn vite build

# Stage 2: Serve with Nginx + reverse-proxy to Colyseus server
FROM nginx:alpine

COPY --from=builder /app/client/dist /usr/share/nginx/html

# Nginx config: SPA routing + reverse proxy for Colyseus matchmaking & WebSocket
ARG COLYSEUS_UPSTREAM=skyoffice-server:2567
RUN printf 'upstream colyseus {\n\
  server '"${COLYSEUS_UPSTREAM}"';\n\
}\n\
server {\n\
  listen 80;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
\n\
  # Serve static Vite assets directly (^~ beats regex matches)\n\
  location ^~ /assets/ {\n\
    try_files $uri =404;\n\
  }\n\
\n\
  # Reverse-proxy Colyseus matchmaking HTTP requests\n\
  location /matchmake/ {\n\
    proxy_pass http://colyseus;\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
  }\n\
\n\
  # Reverse-proxy Colyseus WebSocket room connections (processId/roomId)\n\
  location ~ ^/[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+ {\n\
    proxy_pass http://colyseus;\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Upgrade $http_upgrade;\n\
    proxy_set_header Connection "upgrade";\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_read_timeout 86400;\n\
  }\n\
\n\
  # SPA fallback\n\
  location / {\n\
    try_files $uri $uri/ /index.html;\n\
  }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

