# ===============================
# Stage 1: Build Vite app
# ===============================
FROM node:18-alpine AS builder

WORKDIR /app

# Nhận biến môi trường cho Vite (WebSocket server)
ARG VITE_SERVER_URL
ENV VITE_SERVER_URL=${VITE_SERVER_URL}

# Cài dependencies cho types
COPY types/package.json types/yarn.lock ./types/
RUN cd types && yarn install --frozen-lockfile

# Cài dependencies cho client
COPY client/package.json client/yarn.lock ./client/
RUN cd client && yarn install --frozen-lockfile

# Copy source code
COPY types ./types/
COPY client ./client/

# Build Vite app
WORKDIR /app/client
RUN yarn build


# ===============================
# Stage 2: Serve bằng Nginx
# ===============================
FROM nginx:alpine

# Copy build output
COPY --from=builder /app/client/dist /usr/share/nginx/html

# Nginx config đơn giản (KHÔNG proxy nữa)
RUN printf 'server {\n\
  listen 80;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
\n\
  location / {\n\
    try_files $uri /index.html;\n\
  }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
